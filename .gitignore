*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.eggs/
*.egg-info/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type/Lint caches
.mypy_cache/
.ruff_cache/

# Database (regenerated by seeder)
data/trading_system.db
data/gold/*.db
data/archive/*.parquet
data/archive/
data/*_backup_*.db
data/crontab_backup_*.txt

# Raw data files (regenerated by fetch)
data/raw/
data/clean/
data/bronze/
data/silver/
data/*.parquet

# Replay simulation output (regenerated by scripts/replay_simulation.py)
scripts/replay_results/
scripts/replay_results.json

# Ad-hoc reports (regenerated by analysis scripts)
reports/

# Ad-hoc data files (regenerated by import scripts)
scripts/missing_*.txt

# E2E test screenshots (regenerated by tests/e2e/)
tests/e2e/screenshots/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Installer / binary artifacts (not project-related)
*.deb
*.rpm
*.exe

# Logs
*.log
logs/
/tmp/backend.log
/tmp/frontend.log

# Node (frontend has its own .gitignore too)
node_modules/
.next/

# Test artifacts (mock db_path leaks — files created when a test mocks storage
# but production code calls open(mock.db_path, ...). 0-byte junk to never commit.
<MagicMock*
auth
status
