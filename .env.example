# Trading System — Environment Configuration
# Copy this file to .env and fill in your values.


# ---------- DAILY RUNNER ----------
# Leave DAILY_RUNNER_TICKERS empty/unset to fetch ALL active IDX stocks (928+ tickers)
# Set to comma-separated list to override (e.g. for testing or small watchlist)
# DAILY_RUNNER_TICKERS=BBCA.JK,TLKM.JK,ASII.JK,UNVR.JK,BMRI.JK
# Time to run daily job (24h format, server time)
DAILY_RUNNER_TIME=17:00
# Set to 1 to run once and exit (for cron/Windows Task Scheduler mode)
DAILY_RUNNER_ONCE=0

# ---------- AUTOMATED TRADING ----------
# Set true to enable auto-execution (HATI-HATI! Robot trader akan eksekusi order otomatis)
# Default false = mode monitoring (hanya log, tidak eksekusi nyata)
AUTO_TRADE_ENABLED=false

# Modal awal untuk position sizing (dalam Rupiah)
TRADING_CAPITAL=100000000

# Risk per trade (fraksi dari capital, default 1%)
RISK_PER_TRADE=0.01

# Ambang konviksi (0-100) di bawah mana posisi terbuka akan di-SELL meskipun
# harga belum menyentuh stop-loss/take-profit.
EXIT_CONVICTION_THRESHOLD=40

# ---------- PORTFOLIO REBALANCING ----------
# Aktifkan rebalancing otomatis (true/false)
REBALANCE_ENABLED=false

# Frekuensi rebalancing: daily, weekly, monthly
REBALANCE_FREQUENCY=monthly

# Target bobot dalam format JSON (total harus 1.0)
# Contoh: {"BBCA.JK": 0.4, "TLKM.JK": 0.3, "ASII.JK": 0.3}
REBALANCE_TARGET_WEIGHTS={"BBCA.JK": 0.4, "TLKM.JK": 0.3, "ASII.JK": 0.3}

# ---------- RISK CONTROL ----------
# Daily Loss Limit (dalam Rupiah). Set 0 untuk nonaktif.
# Jika kerugian harian melewati batas ini, auto-trade akan dihentikan untuk hari itu.
DAILY_LOSS_LIMIT=1000000

# ---------- SENTIMENT ANALYSIS ----------
# Reddit API (gratis — daftar di https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=trading_system/1.0

# Twitter/X API (butuh developer account — https://developer.twitter.com)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ---------- MACRO DATA SOURCES ----------
# FRED (Federal Reserve Economic Data) — US rates, commodities, global macro
# Get free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BPS (Badan Pusat Statistik) — GDP, inflation, trade, population
# Register: https://webapi.bps.go.id/v1/
BPS_API_KEY=

# Bank Indonesia — BI rate, exchange rate, money supply
# No API key needed (undocumented JSON endpoints from bi.go.id)

# ---------- GOOGLE TRENDS ----------
# Google Trends menggunakan pytrends (gratis, tidak butuh API key)
# Namun rate-limited — jangan terlalu sering query
# Install: pip install pytrends

# ---------- ENVIRONMENT LOADING ----------
# File .env dimuat otomatis oleh utils/notifier.py saat import pertama.
# Tidak perlu manual load — semua os.getenv() akan membaca nilai dari .env.
# Untuk production, set env vars langsung di sistem operasi atau Docker.

# ---------- DATA ARCHIVE ----------
# Lokasi penyimpanan data raw permanen (Parquet terkompresi).
# Bisa di-override ke external HDD, flashdisk, atau network drive untuk data besar.
# Default: data/archive/ (di dalam project folder).
# Contoh: /media/petrick/153C-7A4C/trading_data/archive untuk flashdisk.
#
# BOOTSTRAP DI KOMPUTER BARU:
# 1. Copy seluruh folder archive/ (termasuk subfolder ohlcv/ dan tables/) ke komputer baru
# 2. Set DATA_ARCHIVE_DIR dan DATA_RAW_DIR ke path tujuan
# 3. Jalankan: python scripts/bootstrap_from_parquet.py
# 4. SQLite DB akan terisi otomatis dari Parquet (OHLCV + 26 tabel lainnya)
DATA_ARCHIVE_DIR=/media/petrick/Parquet/trading_data/archive
DATA_RAW_DIR=/media/petrick/Parquet/trading_data/raw

# ---------- API SECURITY ----------
# Set ke "production" untuk mewajibkan API_KEY non-kosong (fail-fast saat startup
# jika kosong). Default "development" — API_KEY opsional.
ENV=development

# Set API_KEY untuk mengaktifkan autentikasi semua endpoint (kecuali / dan /api/health).
# WAJIB diisi jika ENV=production. Endpoint sensitif (/api/execution/toggle,
# /api/rebalance/toggle) akan dinonaktifkan (503) selama API_KEY masih kosong.
# Untuk koneksi WebSocket /ws/live, sertakan sebagai query param: /ws/live?token=<API_KEY>
API_KEY=

# CORS — daftar origin yang diizinkan, dipisah koma.
# Default: localhost:3000 dan 127.0.0.1:3000 (frontend dev).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting — maksimum request per IP per 60 detik.
RATE_LIMIT_MAX=60

# ---------- YFINANCE RATE LIMITING ----------
# Calibrated via scripts/bench/ratelimit_stress.py (Aug 2026).
# Stress test: 100% success at 0.0s delay for 30 Yahoo Finance requests.
# 0.3s chosen with safety margin for 989-ticker batches (~2000 req/hour safe).
# IDX scraper uses curl_cffi with 0.2s delay + 3x retry for Cloudflare 403s.
YFINANCE_MIN_DELAY=0.3
YFINANCE_MAX_DELAY=1.0
YFINANCE_MAX_REQUESTS=2000
YFINANCE_WINDOW_SECONDS=3600

# ---------- FRONTEND (Next.js) ----------
# NEXT_PUBLIC_* vars are exposed to the browser at build time.
# Set NEXT_PUBLIC_API_BASE to the backend URL reachable from the browser.
NEXT_PUBLIC_API_BASE=http://localhost:8000
# Set NEXT_PUBLIC_API_KEY to match API_KEY above (needed if API_KEY is set on backend).
NEXT_PUBLIC_API_KEY=

# ---------- SENTRY MONITORING ----------
# Get your DSN from https://sentry.io/settings/projects/
# NEXT_PUBLIC_SENTRY_DSN is exposed to browser (client-side errors)
# SENTRY_DSN is for server-side errors
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
